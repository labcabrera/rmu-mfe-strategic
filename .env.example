# rmu-mfe-strategic: local development. Copy to .env and run `make start` (or F5 in VS Code).
#
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to `.env`.
# The RMU_* values are not baked into the bundle: the dev server serves them as /env-config.js
# (keys listed in public/env-config.template.js). They only apply when strategic is opened standalone
# on http://localhost:8082. Inside the shell (http://localhost, through the rmu-platform gateway)
# the shell's configuration is used instead.

# --- Dev server --------------------------------------------------------------------------------
PORT=8082

# --- Static assets -----------------------------------------------------------------------------
# Images and locales. Through the gateway: /mfe/assets/ (rmu-mfe-assets container).
RMU_MFE_ASSETS_URI=http://localhost/mfe/assets/

# --- APIs --------------------------------------------------------------------------------------
# Standalone on :8082 there is no same-origin gateway, so use absolute URLs.
RMU_API_CORE_URI=http://localhost:3001/v1
RMU_API_STRATEGIC_URI=http://localhost:3002/v1
RMU_API_TACTICAL_URI=http://localhost:3003/v1
RMU_API_ATTACK_TABLES_URI=http://localhost:3005/v1
RMU_API_ITEMS_URI=http://localhost:3006/v1
RMU_API_NPC_NAMES_URI=http://localhost:3007/v1
RMU_API_NPCS_URI=http://localhost:3008/v1
RMU_API_SPELLS_URI=http://localhost:3009/v1
RMU_API_MEDIA_URI=http://localhost:3011/v1
